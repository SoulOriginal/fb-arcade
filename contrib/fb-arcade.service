[Unit]
Description=fb-arcade self-playing games on the framebuffer
# The login prompt draws on the same framebuffer, so it must not run at the same time.
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
# Hide the text cursor and disable console blanking, otherwise the screen goes black after ten minutes.
ExecStartPre=/bin/sh -c "printf '\\033[9;0]\\033[?25l' > /dev/tty1"
ExecStart=/usr/bin/python3 /opt/fb-arcade/launcher.py
Restart=always

[Install]
WantedBy=multi-user.target
